{
  "name": "neuralab",
  "version": "0.1.0",
  "description": "Mini Trello for team task management",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "server": "node server/standalone.js",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.3.0",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.5"
  },
  "build": {
    "appId": "com.neuralab.minitrello",
    "productName": "Neuralab",
    "files": [
      "electron/**/*",
      "server/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    }
  }
}
